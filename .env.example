# ============================================
# SignalForge Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# --- LLM Provider ---
# Which LLM provider to use: gemini | openai | anthropic
LLM_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (optional, for future use)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (optional, for future use)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Reddit (PRAW) ---
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=SignalForge/1.0 (by /u/your_reddit_username)

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_CHANNEL_ID=#signalforge-review

# --- Firecrawl ---
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# --- Supabase ---
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# --- Medium ---
MEDIUM_INTEGRATION_TOKEN=your_medium_integration_token_here
MEDIUM_USER_ID=your_medium_user_id_here
MEDIUM_PUBLISH_STATUS=draft
MEDIUM_CONTENT_FORMAT=markdown

# --- SignalForge ---
SIGNALFORGE_PUBLISH_MODE=dry_run
